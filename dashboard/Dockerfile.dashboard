# syntax=docker/dockerfile:1
# Development Dockerfile for the Braidpool dashboard.
# Uses Vite's dev server — swap CMD for `npm run build` + nginx for production.

FROM node:22-slim

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --silent

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
